{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-usage-bridge",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "USAGE_STATE",
        "class_name": "UsageState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UsageState"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
